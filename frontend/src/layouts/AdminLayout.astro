---
/**
 * Admin Layout
 *
 * Protected layout for admin pages with sidebar navigation.
 * Visually distinct from DashboardLayout (red/orange accent).
 */

import BaseLayout from './BaseLayout.astro';
import { AdminAuthCheck } from '@/components/admin';
import { UserMenu } from '@/components/dashboard';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

// Force SSR for protected pages
export const prerender = false;
---

<BaseLayout title={title} description={description}>
  <!-- Auth check - verifies admin role -->
  <AdminAuthCheck client:load />

  <div id="admin-root" class="min-h-screen">
    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <aside class="hidden w-64 border-r bg-card lg:block">
        <div class="flex h-full flex-col">
          <!-- Logo -->
          <div class="flex h-16 items-center border-b px-6">
            <a href="/admin" class="flex items-center gap-2">
              <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-red-500 to-orange-500">
                <span class="text-sm font-bold text-white">P</span>
              </div>
              <span class="font-heading text-xl font-bold">Admin</span>
            </a>
          </div>

          <!-- Navigation -->
          <nav class="flex-1 space-y-1 p-4">
            <a
              href="/admin"
              class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
            >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
              Dashboard
            </a>
            <a
              href="/admin/users"
              class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
            >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
              Users
            </a>
            <a
              href="/admin/audit-log"
              class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
            >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              Audit Log
            </a>

            <div class="my-4 border-t" />

            <a
              href="/dashboard"
              class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
            >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
              </svg>
              Back to App
            </a>
          </nav>

          <!-- User menu -->
          <div class="border-t p-4">
            <UserMenu client:load />
          </div>
        </div>
      </aside>

      <!-- Main content -->
      <main class="flex-1">
        <!-- Mobile header -->
        <header class="flex h-16 items-center justify-between border-b bg-card px-4 lg:hidden">
          <a href="/admin" class="flex items-center gap-2">
            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-red-500 to-orange-500">
              <span class="text-sm font-bold text-white">P</span>
            </div>
            <span class="font-heading text-xl font-bold">Admin</span>
          </a>
          <button type="button" class="rounded-lg p-2 hover:bg-accent" id="admin-mobile-menu-button">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </header>

        <!-- Page content -->
        <div class="p-6">
          <slot />
        </div>
      </main>
    </div>
  </div>
</BaseLayout>
