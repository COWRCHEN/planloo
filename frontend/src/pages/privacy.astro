---
/**
 * Privacy Policy Page
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/shared/Breadcrumb.astro';

const sections = [
  { id: 'collection', title: 'Information We Collect' },
  { id: 'usage', title: 'How We Use Your Information' },
  { id: 'sharing', title: 'How We Share Your Information' },
  { id: 'storage', title: 'Data Storage and Security' },
  { id: 'retention', title: 'Data Retention' },
  { id: 'rights', title: 'Your Rights' },
  { id: 'cookies', title: 'Cookies and Tracking' },
  { id: 'children', title: 'Children\'s Privacy' },
  { id: 'transfers', title: 'International Data Transfers' },
  { id: 'changes', title: 'Changes to This Policy' },
  { id: 'contact', title: 'Contact Us' }
];
---

<BaseLayout
  title="Privacy Policy"
  description="Read the Planloo Privacy Policy. Learn how we collect, use, and protect your personal data when you use our event planning platform."
>
  <!-- Sticky Navigation -->
  <nav class="sticky top-0 z-50 border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
    <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
      <a href="/" class="flex items-center gap-2 transition-opacity hover:opacity-80">
        <div class="flex h-6 w-6 items-center justify-center rounded-md bg-gradient-to-br from-primary-600 to-secondary-600 shadow-md">
          <img src="/logo.svg" alt="Planloo logo" class="h-4 w-4 brightness-0 invert" />
        </div>
        <span class="font-heading text-xl font-bold text-foreground">Planloo</span>
      </a>
      <div class="flex items-center gap-4 text-sm">
        <a href="/terms" class="text-muted-foreground transition-colors hover:text-foreground">Terms of Service</a>
        <a href="/login" class="text-primary transition-colors hover:text-primary/80">Sign In</a>
      </div>
    </div>
  </nav>

  <!-- Breadcrumb -->
  <div class="mx-auto max-w-7xl px-4 pt-4 sm:px-6 lg:px-8">
    <Breadcrumb
      items={[
        { label: 'Home', href: '/' },
        { label: 'Privacy Policy', href: '/privacy', current: true },
      ]}
    />
  </div>

  <!-- Hero Section -->
  <div class="relative overflow-hidden border-b bg-gradient-to-br from-secondary-50 via-background to-primary-50 dark:from-secondary-950/20 dark:via-background dark:to-primary-950/20">
    <div class="absolute inset-0 bg-grid-slate-100 [mask-image:linear-gradient(0deg,white,rgba(255,255,255,0.6))] dark:bg-grid-slate-700/25"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="font-heading text-4xl font-bold tracking-tight text-foreground sm:text-5xl">
          Privacy Policy
        </h1>
        <p class="mt-4 text-lg text-muted-foreground">
          Last updated: <time datetime="2026-02-19">February 19, 2026</time>
        </p>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="lg:grid lg:grid-cols-12 lg:gap-12">
      <!-- Sidebar TOC (Desktop) -->
      <aside class="hidden lg:col-span-3 lg:block">
        <div class="sticky top-24 space-y-1">
          <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-muted-foreground">On This Page</h2>
          <nav class="space-y-1">
            {sections.map((section, index) => (
              <a
                href={`#${section.id}`}
                class="group flex items-start gap-3 rounded-lg px-3 py-2 text-sm text-muted-foreground transition-all hover:bg-muted hover:text-foreground"
              >
                <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-md bg-muted text-xs font-medium text-muted-foreground transition-colors group-hover:bg-secondary group-hover:text-secondary-foreground">
                  {index + 1}
                </span>
                <span class="line-clamp-2">{section.title}</span>
              </a>
            ))}
          </nav>
        </div>
      </aside>

      <!-- Main Article -->
      <article class="lg:col-span-9">
        <div class="prose prose-neutral dark:prose-invert max-w-none">
          <!-- Introduction -->
          <div class="rounded-lg border bg-muted/50 p-6 not-prose mb-8">
            <p class="text-base leading-relaxed text-foreground">
              At Planloo, we take your privacy seriously. This Privacy Policy explains what information we collect,
              how we use it, and what choices you have. By using Planloo, you agree to the practices described in
              this policy.
            </p>
          </div>

          <!-- Section 1 -->
          <section id="collection" class="scroll-mt-24">
            <h2 class="group relative flex items-center gap-3 border-l-4 border-secondary pl-4 font-heading text-2xl font-bold tracking-tight text-foreground">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-secondary text-sm font-bold text-secondary-foreground">1</span>
              Information We Collect
            </h2>

            <h3 class="mt-6 font-heading text-xl font-semibold text-foreground">Information You Provide</h3>
            <ul class="mt-4 space-y-2">
              <li><strong>Account information:</strong> Name, email address, and password when you create an account.</li>
              <li><strong>Profile information:</strong> Optional details such as a profile photo or display name.</li>
              <li><strong>Event data:</strong> Event details, guest lists, budgets, tasks, seating arrangements, and other content you create within the Service.</li>
              <li><strong>Communications:</strong> Messages you send to us for support or feedback.</li>
            </ul>

            <h3 class="mt-6 font-heading text-xl font-semibold text-foreground">Information Collected Automatically</h3>
            <ul class="mt-4 space-y-2">
              <li><strong>Usage data:</strong> Pages visited, features used, and actions taken within the Service.</li>
              <li><strong>Device information:</strong> Browser type, operating system, and device identifiers.</li>
              <li><strong>Log data:</strong> IP address, access times, and referring URLs.</li>
            </ul>

            <h3 class="mt-6 font-heading text-xl font-semibold text-foreground">Information from Third Parties</h3>
            <p class="mt-4">
              If you sign in using a third-party service (such as Google), we receive your name, email address, and
              profile picture as authorized by that service.
            </p>
          </section>

          <!-- Section 2 -->
          <section id="usage" class="scroll-mt-24">
            <h2 class="group relative flex items-center gap-3 border-l-4 border-secondary pl-4 font-heading text-2xl font-bold tracking-tight text-foreground">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-secondary text-sm font-bold text-secondary-foreground">2</span>
              How We Use Your Information
            </h2>
            <p class="mt-4">We use the information we collect to:</p>
            <ul class="mt-4 space-y-2">
              <li>Provide, maintain, and improve the Service.</li>
              <li>Create and manage your account.</li>
              <li>Process and store your event planning data.</li>
              <li>Send transactional emails (account verification, password resets, event notifications).</li>
              <li>Respond to your support requests and communications.</li>
              <li>Detect and prevent fraud, abuse, and security incidents.</li>
              <li>Comply with legal obligations.</li>
            </ul>
          </section>

          <!-- Section 3 -->
          <section id="sharing" class="scroll-mt-24">
            <h2 class="group relative flex items-center gap-3 border-l-4 border-secondary pl-4 font-heading text-2xl font-bold tracking-tight text-foreground">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-secondary text-sm font-bold text-secondary-foreground">3</span>
              How We Share Your Information
            </h2>
            <p class="mt-4">
              We do not sell your personal information. We may share your information only in these circumstances:
            </p>
            <ul class="mt-4 space-y-2">
              <li><strong>With your consent:</strong> When you explicitly authorize sharing, such as inviting collaborators to your events.</li>
              <li><strong>Service providers:</strong> With trusted third-party services that help us operate the Service (e.g., hosting, email delivery), bound by confidentiality obligations.</li>
              <li><strong>Legal requirements:</strong> When required by law, regulation, or legal process.</li>
              <li><strong>Safety:</strong> To protect the rights, safety, or property of Planloo, our users, or the public.</li>
            </ul>
          </section>

          <!-- Section 4 -->
          <section id="storage" class="scroll-mt-24">
            <h2 class="group relative flex items-center gap-3 border-l-4 border-secondary pl-4 font-heading text-2xl font-bold tracking-tight text-foreground">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-secondary text-sm font-bold text-secondary-foreground">4</span>
              Data Storage and Security
            </h2>
            <p class="mt-4">
              Your data is stored on Cloudflare's global infrastructure. We implement appropriate technical and
              organizational measures to protect your information, including encryption in transit (TLS) and secure
              password hashing. However, no method of transmission or storage is completely secure, and we cannot
              guarantee absolute security.
            </p>
          </section>

          <!-- Section 5 -->
          <section id="retention" class="scroll-mt-24">
            <h2 class="group relative flex items-center gap-3 border-l-4 border-secondary pl-4 font-heading text-2xl font-bold tracking-tight text-foreground">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-secondary text-sm font-bold text-secondary-foreground">5</span>
              Data Retention
            </h2>
            <p class="mt-4">
              We retain your account information and event data for as long as your account is active. If you delete
              your account, we will delete or anonymize your personal data within 30 days, except where retention is
              required by law. Some data may persist in backups for a limited period.
            </p>
          </section>

          <!-- Section 6 -->
          <section id="rights" class="scroll-mt-24">
            <h2 class="group relative flex items-center gap-3 border-l-4 border-secondary pl-4 font-heading text-2xl font-bold tracking-tight text-foreground">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-secondary text-sm font-bold text-secondary-foreground">6</span>
              Your Rights
            </h2>
            <p class="mt-4">Depending on your location, you may have the right to:</p>
            <ul class="mt-4 space-y-2">
              <li><strong>Access:</strong> Request a copy of the personal data we hold about you.</li>
              <li><strong>Correction:</strong> Request correction of inaccurate or incomplete data.</li>
              <li><strong>Deletion:</strong> Request deletion of your personal data.</li>
              <li><strong>Portability:</strong> Request your data in a portable format.</li>
              <li><strong>Objection:</strong> Object to certain processing of your data.</li>
            </ul>
            <p class="mt-4">
              To exercise any of these rights, contact us at
              <a href="mailto:privacy@planloo.com" class="font-medium text-secondary underline underline-offset-4 transition-colors hover:text-secondary/80">privacy@planloo.com</a>.
            </p>
          </section>

          <!-- Section 7 -->
          <section id="cookies" class="scroll-mt-24">
            <h2 class="group relative flex items-center gap-3 border-l-4 border-secondary pl-4 font-heading text-2xl font-bold tracking-tight text-foreground">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-secondary text-sm font-bold text-secondary-foreground">7</span>
              Cookies and Tracking
            </h2>
            <p class="mt-4">
              Planloo uses essential cookies to maintain your session and authentication state. We do not use
              third-party advertising or tracking cookies. We may use minimal analytics to understand how the
              Service is used and to improve it.
            </p>
          </section>

          <!-- Section 8 -->
          <section id="children" class="scroll-mt-24">
            <h2 class="group relative flex items-center gap-3 border-l-4 border-secondary pl-4 font-heading text-2xl font-bold tracking-tight text-foreground">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-secondary text-sm font-bold text-secondary-foreground">8</span>
              Children's Privacy
            </h2>
            <p class="mt-4">
              The Service is not directed at children under 16. We do not knowingly collect personal information
              from children under 16. If we learn that we have collected data from a child under 16, we will take
              steps to delete it promptly.
            </p>
          </section>

          <!-- Section 9 -->
          <section id="transfers" class="scroll-mt-24">
            <h2 class="group relative flex items-center gap-3 border-l-4 border-secondary pl-4 font-heading text-2xl font-bold tracking-tight text-foreground">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-secondary text-sm font-bold text-secondary-foreground">9</span>
              International Data Transfers
            </h2>
            <p class="mt-4">
              Your information may be processed on servers located outside your country of residence. By using the
              Service, you consent to the transfer of your data to locations where Cloudflare operates its
              infrastructure. We take measures to ensure your data is protected in accordance with this policy.
            </p>
          </section>

          <!-- Section 10 -->
          <section id="changes" class="scroll-mt-24">
            <h2 class="group relative flex items-center gap-3 border-l-4 border-secondary pl-4 font-heading text-2xl font-bold tracking-tight text-foreground">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-secondary text-sm font-bold text-secondary-foreground">10</span>
              Changes to This Policy
            </h2>
            <p class="mt-4">
              We may update this Privacy Policy from time to time. If we make material changes, we will notify you
              by email or through the Service. The "Last updated" date at the top indicates when this policy was
              last revised.
            </p>
          </section>

          <!-- Section 11 -->
          <section id="contact" class="scroll-mt-24">
            <h2 class="group relative flex items-center gap-3 border-l-4 border-secondary pl-4 font-heading text-2xl font-bold tracking-tight text-foreground">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-secondary text-sm font-bold text-secondary-foreground">11</span>
              Contact Us
            </h2>
            <p class="mt-4">
              If you have any questions or concerns about this Privacy Policy, please contact us at
              <a href="mailto:privacy@planloo.com" class="font-medium text-secondary underline underline-offset-4 transition-colors hover:text-secondary/80">privacy@planloo.com</a>.
            </p>
          </section>
        </div>
      </article>
    </div>
  </div>

  <!-- Footer -->
  <footer class="border-t bg-muted/30">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
        <div class="flex items-center gap-2">
          <div class="flex h-6 w-6 items-center justify-center rounded-md bg-gradient-to-br from-primary-600 to-secondary-600 shadow-md">
            <img src="/logo.svg" alt="Planloo logo" class="h-4 w-4 brightness-0 invert" />
          </div>
          <span class="font-heading text-xl font-bold text-foreground">Planloo</span>
        </div>
        <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm">
          <a href="/privacy" class="text-muted-foreground transition-colors hover:text-secondary">Privacy Policy</a>
          <a href="/terms" class="text-muted-foreground transition-colors hover:text-secondary">Terms of Service</a>
          <a href="/register" class="text-muted-foreground transition-colors hover:text-secondary">Create Account</a>
          <a href="/login" class="text-muted-foreground transition-colors hover:text-secondary">Sign In</a>
        </nav>
      </div>
      <div class="mt-8 border-t pt-8 text-center text-sm text-muted-foreground">
        <p>&copy; {new Date().getFullYear()} Planloo. All rights reserved.</p>
      </div>
    </div>
  </footer>
</BaseLayout>

<style>
  html {
    scroll-behavior: smooth;
  }

  .bg-grid-slate-100 {
    background-image: linear-gradient(to right, rgb(241 245 249 / 0.3) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(241 245 249 / 0.3) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  .dark .bg-grid-slate-700\/25 {
    background-image: linear-gradient(to right, rgb(51 65 85 / 0.25) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(51 65 85 / 0.25) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  .prose section {
    margin-top: 3rem;
    padding-top: 3rem;
    border-top: 1px solid hsl(var(--border));
  }

  .prose section:first-of-type {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .prose h3 {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
</style>
