---
/**
 * Register Page
 */

import AuthLayout from '@/layouts/AuthLayout.astro';
import { RegisterView } from '@/components/auth/RegisterView';

// Get return URL from query params (e.g. from invitation flow)
const returnUrl = Astro.url.searchParams.get('returnUrl') || '/dashboard';
---

<AuthLayout title="Create Account" description="Create your Planloo account">
  <div class="space-y-6">
    <div class="space-y-2 text-center">
      <h1 class="font-heading text-2xl font-semibold tracking-tight">
        Create an account
      </h1>
      <p class="text-sm text-muted-foreground">
        Get started with Planloo to plan your perfect events
      </p>
    </div>

    <RegisterView client:load returnUrl={returnUrl} />
  </div>
</AuthLayout>
