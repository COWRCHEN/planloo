---
/**
 * Verify Email Page
 *
 * Handles email verification tokens from signup emails.
 */

import AuthLayout from '@/layouts/AuthLayout.astro';
import { VerifyEmailView } from '@/components/auth/VerifyEmailView';
---

<AuthLayout title="Verify Email" description="Verify your Planloo email address">
  <div class="space-y-6">
    <div class="space-y-2 text-center">
      <h1 class="font-heading text-2xl font-semibold tracking-tight">
        Email Verification
      </h1>
    </div>

    <VerifyEmailView client:load />
  </div>
</AuthLayout>
