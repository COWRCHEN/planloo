      <script>
        const btnMonthly = document.getElementById('billing-monthly')!;
        const btnAnnual = document.getElementById('billing-annual')!;

        function setMode(mode: 'monthly' | 'annual') {
          const isAnnual = mode === 'annual';

          btnMonthly.classList.toggle('bg-background', !isAnnual);
          btnMonthly.classList.toggle('shadow-sm', !isAnnual);
          btnMonthly.classList.toggle('text-foreground', !isAnnual);
          btnMonthly.classList.toggle('text-muted-foreground', isAnnual);

          btnAnnual.classList.toggle('bg-background', isAnnual);
          btnAnnual.classList.toggle('shadow-sm', isAnnual);
          btnAnnual.classList.toggle('text-foreground', isAnnual);
          btnAnnual.classList.toggle('text-muted-foreground', !isAnnual);

          document.querySelectorAll<HTMLElement>('[data-monthly]').forEach(el => {
            el.classList.toggle('hidden', isAnnual);
          });
          document.querySelectorAll<HTMLElement>('[data-annual]').forEach(el => {
            el.classList.toggle('hidden', !isAnnual);
          });
        }

        btnMonthly.addEventListener('click', () => setMode('monthly'));
        btnAnnual.addEventListener('click', () => setMode('annual'));
      </script>
