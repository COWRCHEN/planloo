---
/**
 * Homepage - Marketing landing page
 */

import BaseLayout from '@/layouts/BaseLayout.astro';

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://planloo.com';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Planloo',
  url: siteUrl,
  description: 'All-in-one event planning platform for individuals and teams.',
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Planloo',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'support@planloo.com',
    contactType: 'customer service',
  },
  sameAs: ['https://twitter.com/planloo', 'https://www.linkedin.com/company/planloo'],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is Planloo?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Planloo is an all-in-one event planning platform for individuals and teams. It helps you manage guests, track your budget, coordinate tasks, plan seating arrangements, and work with vendors — all in a single workspace.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is Planloo free to use?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Planloo offers a free plan with no credit card required. Paid plans are available for larger events, more collaborators, and advanced features.',
      },
    },
    {
      '@type': 'Question',
      name: 'What types of events can I plan with Planloo?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Planloo supports 14 event types: weddings, birthday parties, corporate events, conferences, holiday parties, engagement parties, fundraisers, anniversary celebrations, graduation parties, retirement parties, baby showers, bridal showers, themed parties, and celebrations of life. It scales from intimate gatherings to events with 1,000+ guests.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can multiple people collaborate on an event in Planloo?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. You can invite co-planners, assign roles, and work simultaneously on the same event. Planloo keeps a full audit trail so you can see who changed what and when.',
      },
    },
    {
      '@type': 'Question',
      name: 'How does guest management work in Planloo?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'You can import guests from a CSV file or add them manually. Planloo generates personalised invitation links for each guest to collect RSVPs automatically. You can track dietary requirements, attendance status, and table assignments.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does Planloo have a seating planner?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Planloo includes a drag-and-drop seating planner with real-time conflict detection. You can create custom floor plans with different table shapes and seat guests with confidence, whether you have 10 or 1,000 attendees.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I manage vendors and service providers in Planloo?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Planloo includes a vendor directory where you can browse and save caterers, venues, photographers, florists, and other service providers. You can store contracts, reviews, pricing notes, and contact details alongside each provider.',
      },
    },
  ],
};

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Planloo',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    description: 'Free plan available',
  },
  keywords: 'event planning, wedding planning, birthday party planning, corporate event planning, conference planning, engagement party, fundraiser planning, anniversary celebration, graduation party, retirement party, baby shower, bridal shower, themed party, celebration of life',
  description:
    'All-in-one event planning platform with guest management, budgeting, task tracking, and seating arrangements. Supports 14 event types including weddings, corporate events, birthdays, conferences, and more.',
};

const features = [
  {
    title: 'Guest Management',
    description:
      'Import, organise, and track every guest. Send invitations, collect RSVPs, and manage dietary requirements — all in one place.',
    icon: 'guests',
  },
  {
    title: 'Smart Budgeting',
    description:
      'Set a budget, log expenses, and track payments. Real-time charts keep you informed before costs get out of hand.',
    icon: 'budget',
  },
  {
    title: 'Task Tracking',
    description:
      'Create checklists, assign tasks to collaborators, and set due dates. Never miss a deadline in the lead-up to your event.',
    icon: 'tasks',
  },
  {
    title: 'Seating Planner',
    description:
      'Drag-and-drop seating arrangements with real-time conflict detection. Seat 10 guests or 1,000 with confidence.',
    icon: 'seating',
  },
  {
    title: 'Team Collaboration',
    description:
      'Invite co-planners, assign roles, and work simultaneously. See who changed what, when, with a full audit trail.',
    icon: 'collab',
  },
  {
    title: 'Vendor Directory',
    description:
      'Browse caterers, venues, photographers, and more. Store contracts, reviews, and contact details with each provider.',
    icon: 'vendors',
  },
];

const steps = [
  {
    number: '01',
    title: 'Create your event',
    description:
      'Add a name, date, and location. Set your budget and invite your first collaborator in under a minute.',
  },
  {
    number: '02',
    title: 'Build your guest list',
    description:
      'Import from CSV or add guests manually. Collect RSVPs automatically via personalised invitation links.',
  },
  {
    number: '03',
    title: 'Manage tasks and budget',
    description:
      'Create a task checklist, log vendor payments, and watch your budget dashboard update in real time.',
  },
  {
    number: '04',
    title: 'Execute with confidence',
    description:
      'Use the check-in tool on the day, print seating charts, and access everything from any device.',
  },
];

const eventTypes = [
  { slug: 'wedding', label: 'Wedding', description: 'Full ceremony and reception planning, from guest lists to seating charts' },
  { slug: 'birthday', label: 'Birthday Party', description: 'Milestone and everyday celebrations, intimate or large-scale' },
  { slug: 'corporate', label: 'Corporate Event', description: 'Company away days, product launches, and client-facing events' },
  { slug: 'conference', label: 'Conference', description: 'Multi-session professional gatherings and symposiums' },
  { slug: 'holiday_party', label: 'Holiday Party', description: 'Seasonal and festive celebrations for teams or families' },
  { slug: 'engagement_party', label: 'Engagement Party', description: 'Celebrations marking the start of a wedding journey' },
  { slug: 'fundraiser', label: 'Fundraiser', description: 'Charity galas, auctions, and donor appreciation events' },
  { slug: 'anniversary', label: 'Anniversary', description: 'Personal and corporate milestone celebrations' },
  { slug: 'graduation', label: 'Graduation', description: 'Academic and professional achievement celebrations' },
  { slug: 'retirement', label: 'Retirement Party', description: 'Farewell and appreciation events for outgoing colleagues' },
  { slug: 'baby_shower', label: 'Baby Shower', description: 'Pre-birth celebrations welcoming new arrivals' },
  { slug: 'bridal_shower', label: 'Bridal Shower', description: 'Pre-wedding celebrations for the bride-to-be' },
  { slug: 'themed', label: 'Themed Party', description: 'Costume parties, murder mystery nights, and themed galas' },
  { slug: 'celebration_of_life', label: 'Celebration of Life', description: 'Meaningful gatherings to honour and remember loved ones' },
];

const eventTypesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Event Types Supported by Planloo',
  description: 'Planloo supports planning 14 types of events, from weddings and birthday parties to corporate conferences and celebrations of life.',
  itemListElement: eventTypes.map(({ label, description }, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: label,
    description,
  })),
};
---

<BaseLayout
  title="Event Planning Made Simple"
  description="Planloo is the all-in-one event planning platform. Manage guests, budgets, tasks, and seating — all in one place. Start free today."
  schema={[websiteSchema, organizationSchema, softwareSchema, faqSchema, eventTypesSchema]}
>
  <!-- Navigation -->
  <header>
    <nav
      class="sticky top-0 z-50 border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60"
      aria-label="Main navigation"
    >
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <a
          href="/"
          class="flex items-center gap-2 transition-opacity hover:opacity-80"
          aria-label="Planloo home"
        >
          <div
            class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-primary-600 to-secondary-600 shadow-md"
          >
            <span class="text-sm font-bold text-white" aria-hidden="true">P</span>
          </div>
          <span class="font-heading text-xl font-bold text-foreground">Planloo</span>
        </a>

        <div class="hidden items-center gap-6 text-sm md:flex">
          <a href="#features" class="text-muted-foreground transition-colors hover:text-foreground"
            >Features</a
          >
          <a
            href="#how-it-works"
            class="text-muted-foreground transition-colors hover:text-foreground">How it works</a
          >
          <a href="#pricing" class="text-muted-foreground transition-colors hover:text-foreground"
            >Pricing</a
          >
          <a href="/login" class="text-muted-foreground transition-colors hover:text-foreground"
            >Sign in</a
          >
          <a
            href="/register"
            class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex h-9 items-center justify-center rounded-lg px-4 text-sm font-medium shadow transition-colors"
          >
            Get started free
          </a>
        </div>

        <!-- Mobile CTA -->
        <a
          href="/register"
          class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex h-9 items-center justify-center rounded-lg px-4 text-sm font-medium shadow transition-colors md:hidden"
        >
          Get started
        </a>
      </div>
    </nav>
  </header>

  <main>
    <!-- Hero -->
    <section
      class="relative overflow-hidden bg-gradient-to-br from-primary-50 via-background to-secondary-50 dark:from-primary-950/20 dark:via-background dark:to-secondary-950/20"
      aria-labelledby="hero-heading"
    >
      <div
        class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,#f0f0f0_1px,transparent_1px),linear-gradient(to_bottom,#f0f0f0_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_80%_50%_at_50%_0%,black_60%,transparent_100%)] dark:bg-[linear-gradient(to_right,#1f2937_1px,transparent_1px),linear-gradient(to_bottom,#1f2937_1px,transparent_1px)]"
        aria-hidden="true"
      >
      </div>

      <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8 lg:py-36">
        <div class="mx-auto max-w-3xl text-center">
          <div
            class="mb-6 inline-flex items-center gap-2 rounded-full border bg-background/80 px-4 py-1.5 text-sm font-medium text-muted-foreground shadow-sm"
          >
            <span class="h-2 w-2 rounded-full bg-green-500" aria-hidden="true"></span>
            Free plan — no credit card required
          </div>

          <h1
            id="hero-heading"
            class="font-heading text-4xl font-bold tracking-tight text-foreground sm:text-5xl lg:text-6xl"
          >
            Plan your perfect event —
            <span
              class="bg-gradient-to-r from-primary-600 to-secondary-600 bg-clip-text text-transparent"
            >
              without the chaos
            </span>
          </h1>

          <p class="mt-6 text-lg leading-8 text-muted-foreground sm:text-xl">
            Planloo brings together everything you need: guest lists, budgets, tasks, seating, and
            vendor coordination — in one intuitive platform built for event planners of all sizes.
          </p>

          <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
            <a
              href="/register"
              class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex h-11 min-w-[160px] items-center justify-center rounded-lg px-6 text-base font-semibold shadow-md transition-all hover:shadow-lg"
            >
              Start planning free
            </a>
            <a
              href="#how-it-works"
              class="inline-flex h-11 min-w-[160px] items-center justify-center gap-2 rounded-lg border bg-background px-6 text-base font-medium text-foreground shadow-sm transition-colors hover:bg-accent"
            >
              See how it works
              <svg
                class="h-4 w-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </a>
          </div>

          <p class="mt-4 text-sm text-muted-foreground">
            Join thousands of event planners already using Planloo
          </p>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section id="features" class="py-20 sm:py-28" aria-labelledby="features-heading">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <h2
            id="features-heading"
            class="font-heading text-3xl font-bold tracking-tight text-foreground sm:text-4xl"
          >
            Everything you need to plan a flawless event
          </h2>
          <p class="mt-4 text-lg text-muted-foreground">
            From the first guest invite to the final thank-you note, Planloo has every tool you need
            in one place.
          </p>
        </div>

        <div class="mt-16 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {
            features.map(feature => (
              <article class="group relative rounded-2xl border bg-card p-6 shadow-sm transition-shadow hover:shadow-md">
                <div class="bg-primary/10 mb-4 flex h-12 w-12 items-center justify-center rounded-xl">
                  {feature.icon === 'guests' && (
                    <svg
                      class="text-primary h-6 w-6"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
                      />
                    </svg>
                  )}
                  {feature.icon === 'budget' && (
                    <svg
                      class="text-primary h-6 w-6"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                      />
                    </svg>
                  )}
                  {feature.icon === 'tasks' && (
                    <svg
                      class="text-primary h-6 w-6"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"
                      />
                    </svg>
                  )}
                  {feature.icon === 'seating' && (
                    <svg
                      class="text-primary h-6 w-6"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <circle
                        cx="12"
                        cy="12"
                        r="5"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                      <circle cx="12" cy="3.5" r="1.2" fill="currentColor" stroke="none" />
                      <circle cx="19.4" cy="7.75" r="1.2" fill="currentColor" stroke="none" />
                      <circle cx="19.4" cy="16.25" r="1.2" fill="currentColor" stroke="none" />
                      <circle cx="12" cy="20.5" r="1.2" fill="currentColor" stroke="none" />
                      <circle cx="4.6" cy="16.25" r="1.2" fill="currentColor" stroke="none" />
                      <circle cx="4.6" cy="7.75" r="1.2" fill="currentColor" stroke="none" />
                    </svg>
                  )}
                  {feature.icon === 'collab' && (
                    <svg
                      class="text-primary h-6 w-6"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                      />
                    </svg>
                  )}
                  {feature.icon === 'vendors' && (
                    <svg
                      class="text-primary h-6 w-6"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                      />
                    </svg>
                  )}
                </div>
                <h3 class="font-heading text-lg font-semibold text-foreground">{feature.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                  {feature.description}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Event Types -->
    <section class="border-t py-20 sm:py-28" aria-labelledby="event-types-heading">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <h2
            id="event-types-heading"
            class="font-heading text-3xl font-bold tracking-tight text-foreground sm:text-4xl"
          >
            Works for every occasion
          </h2>
          <p class="mt-4 text-lg text-muted-foreground">
            From intimate gatherings to large-scale productions, Planloo adapts to any type of event.
          </p>
        </div>

        <ul
          class="mt-12 flex flex-wrap justify-center gap-3"
          aria-label="Supported event types"
        >
          {
            eventTypes.map(({ label, description }) => (
              <li>
                <span
                  class="flex flex-col gap-1 rounded-xl border bg-card px-5 py-3 shadow-sm transition-shadow hover:shadow-md"
                  title={description}
                >
                  <span class="text-sm font-semibold text-foreground">{label}</span>
                  <span class="max-w-[200px] text-xs leading-relaxed text-muted-foreground">
                    {description}
                  </span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- How It Works -->
    <section
      id="how-it-works"
      class="border-y bg-muted/30 py-20 sm:py-28"
      aria-labelledby="how-it-works-heading"
    >
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <h2
            id="how-it-works-heading"
            class="font-heading text-3xl font-bold tracking-tight text-foreground sm:text-4xl"
          >
            From idea to execution in 4 steps
          </h2>
          <p class="mt-4 text-lg text-muted-foreground">
            Planloo is designed to get you set up in minutes, not days.
          </p>
        </div>

        <ol class="mt-16 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
          {
            steps.map(step => (
              <li class="relative flex flex-col">
                <div class="bg-primary/10 mb-4 flex h-14 w-14 items-center justify-center rounded-2xl">
                  <span class="text-primary font-heading text-xl font-bold">{step.number}</span>
                </div>
                <h3 class="font-heading text-lg font-semibold text-foreground">{step.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{step.description}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Pricing -->
    <section id="pricing" class="py-20 sm:py-28" aria-labelledby="pricing-heading">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="mx-auto max-w-2xl text-center">
          <h2
            id="pricing-heading"
            class="font-heading text-3xl font-bold tracking-tight text-foreground sm:text-4xl"
          >
            Simple, transparent pricing
          </h2>
          <p class="mt-4 text-lg text-muted-foreground">
            Start free and scale as you grow. No hidden fees, no surprises.
          </p>

          <!-- Billing toggle -->
          <div
            class="mt-8 inline-flex items-center gap-1 rounded-xl border bg-muted p-1"
            role="group"
            aria-label="Billing frequency"
          >
            <button
              id="billing-monthly"
              type="button"
              class="rounded-lg bg-background px-5 py-2 text-sm font-medium text-foreground shadow-sm transition-all"
            >
              Monthly
            </button>
            <button
              id="billing-annual"
              type="button"
              class="flex items-center gap-2 rounded-lg px-5 py-2 text-sm font-medium text-muted-foreground transition-all"
            >
              Annual
              <span
                class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-semibold text-green-700 dark:bg-green-900/40 dark:text-green-400"
              >
                Save ~15%
              </span>
            </button>
          </div>
        </div>

        <!-- Plan cards -->
        <div
          class="-mx-4 mt-12 overflow-x-auto px-4 pb-4 sm:-mx-6 sm:px-6 lg:mx-0 lg:overflow-visible lg:px-0"
        >
          <div class="mx-auto grid w-[900px] grid-cols-5 gap-3 lg:w-auto">
            <!-- Free -->
            <div class="flex flex-col rounded-2xl border bg-card p-5 shadow-sm">
              <div>
                <h3 class="font-heading text-base font-semibold text-foreground">Free</h3>
                <p class="mt-0.5 text-xs text-muted-foreground">Try it out</p>
              </div>
              <div class="mt-4">
                <p class="text-3xl font-bold text-foreground" data-monthly>
                  $0 <span class="text-sm font-normal text-muted-foreground">/mo</span>
                </p>
                <p class="hidden text-3xl font-bold text-foreground" data-annual>
                  $0 <span class="text-sm font-normal text-muted-foreground">/mo</span>
                </p>
                <p class="mt-1 h-4 text-xs text-muted-foreground" data-monthly>&nbsp;</p>
                <p class="mt-1 hidden h-4 text-xs text-muted-foreground" data-annual>&nbsp;</p>
              </div>
              <ul class="mt-5 flex-1 space-y-2.5 text-xs text-muted-foreground">
                <li class="flex items-start gap-2">
                  <svg
                    class="text-primary mt-0.5 h-3.5 w-3.5 shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    ><path
