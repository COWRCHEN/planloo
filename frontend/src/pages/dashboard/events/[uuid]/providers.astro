---
/**
 * Event Providers Page
 *
 * Manages service providers and venues linked to a specific event.
 */

import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { EventProvidersView } from '@/components/providers-directory';

export const prerender = false;

const { uuid } = Astro.params;

// Fetch event name server-side for the page title
const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787/api/v1';
let eventName = '';
try {
  const cookie = Astro.request.headers.get('cookie') ?? '';
  const res = await fetch(`${API_URL}/events/${uuid}`, {
    headers: { cookie },
  });
  if (res.ok) {
    const json = await res.json();
    eventName = json?.data?.title ?? '';
  }
} catch {
  // Silently fall back to no event name
}

const pageTitle = eventName ? `Providers & Venues — ${eventName}` : 'Providers & Venues';
---

<DashboardLayout title={pageTitle} description="Manage event service providers and venues">
  <div class="space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="min-w-0">
        <h1 class="truncate text-2xl font-bold tracking-tight">
          Providers & Venues{eventName && <span class="font-normal text-muted-foreground"> ({eventName})</span>}
        </h1>
        <p class="text-muted-foreground">
          Manage service providers and venues for this event.
        </p>
      </div>
      <div class="flex shrink-0 items-center gap-2">
        <a
          href={`/dashboard/events/${uuid}`}
          class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-primary-300 bg-white text-primary-700 shadow-sm hover:bg-primary-50 hover:border-primary-400 h-9 px-4 py-2"
       >
          Back to Event
        </a>
      </div>
    </div>

    <EventProvidersView client:load eventUuid={uuid} />
  </div>
</DashboardLayout>
