---
/**
 * Create Event Page
 *
 * Multi-step form for creating a new event.
 */

import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { EventFormView } from '@/components/events';

export const prerender = false;
---

<DashboardLayout title="Create Event" description="Create a new event">
  <div class="space-y-6">
    <div class="flex items-center gap-4">
      <a
        href="/dashboard/events"
        class="flex h-10 w-10 items-center justify-center rounded-lg border hover:bg-muted"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </a>
      <div>
        <h1 class="font-heading text-3xl font-bold">Create Event</h1>
        <p class="text-muted-foreground">Set up your new event step by step.</p>
      </div>
    </div>

    <EventFormView client:load mode="create" />
  </div>
</DashboardLayout>
