---
/**
 * Organizations List Page
 *
 * Displays all user's organizations.
 */

import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { OrganizationsView } from '@/components/organizations';

export const prerender = false;
---

<DashboardLayout title="Organizations" description="Manage your organizations">
  <div class="space-y-6">
    <div>
      <h1 class="font-heading text-3xl font-bold">Organizations</h1>
      <p class="text-muted-foreground">Create and manage your organizations and teams.</p>
    </div>

    <OrganizationsView client:load />
  </div>
</DashboardLayout>
