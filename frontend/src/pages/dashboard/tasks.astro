---
/**
 * Tasks Landing Page
 *
 * Shows a list of events with links to their task lists.
 */

import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { TasksLandingView } from '@/components/tasks';

export const prerender = false;
---

<DashboardLayout title="Task Management" description="Manage tasks across your events">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight">Task Management</h1>
      <p class="text-muted-foreground">
        Select an event to manage its tasks and checklist.
      </p>
    </div>

    <TasksLandingView client:load />
  </div>
</DashboardLayout>
