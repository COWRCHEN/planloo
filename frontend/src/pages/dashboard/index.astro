---
/**
 * Dashboard Home Page
 */

import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { DashboardView } from '@/components/dashboard';

export const prerender = false;
---

<DashboardLayout title="Dashboard" description="Your Planloo dashboard">
  <div class="space-y-6">
    <div>
      <h1 class="font-heading text-3xl font-bold">Dashboard</h1>
      <p class="text-muted-foreground">Welcome to your event planning dashboard.</p>
    </div>

    <DashboardView client:load />
  </div>
</DashboardLayout>
