---
/**
 * Tables Landing Page
 *
 * Shows a list of events with links to their seating charts.
 */

import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { TablesLandingView } from '@/components/seating/TablesLandingView';

export const prerender = false;
---

<DashboardLayout title="Seating Charts" description="Manage seating charts across your events">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight">Tables & Seating</h1>
      <p class="text-muted-foreground">
        Select an event to manage its seating chart.
      </p>
    </div>

    <TablesLandingView client:load />
  </div>
</DashboardLayout>
