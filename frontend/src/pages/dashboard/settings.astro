---
/**
 * Account Settings Page
 *
 * User settings for profile and security management.
 */

import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { SettingsView } from '@/components/settings';

export const prerender = false;
---

<DashboardLayout title="Settings" description="Manage your account settings">
  <div class="space-y-6">
    <div>
      <h1 class="font-heading text-3xl font-bold">Settings</h1>
      <p class="text-muted-foreground">Manage your account settings and preferences.</p>
    </div>

    <SettingsView client:load />

    <div class="border-t pt-6">
      <h2 class="text-lg font-semibold mb-1">Billing</h2>
      <p class="text-muted-foreground text-sm mb-3">Manage your subscription and view usage.</p>
      <a href="/dashboard/billing" class="inline-flex items-center gap-2 text-sm font-medium text-primary underline-offset-4 hover:underline">
        Go to Billing &rarr;
      </a>
    </div>
  </div>
</DashboardLayout>
